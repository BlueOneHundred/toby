{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gratis-community-mobile",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "PhoneRoom"
      }
    ],
    "code_update_strategy": {
      "mode": "immediate"
    }
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PhoneRoom"
      ]
    }
  ],
  "secrets": {
    "required": [
      "MOBILE_ENROLLMENT_KEY"
    ]
  },
  "observability": {
    "enabled": false
  }
}
