{
  "name": "gratis-community",
  "productName": "Gratis",
  "version": "0.18.0",
  "private": true,
  "description": "Gratis desktop and mobile companion, maintained in the private community repository",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:desktop": "SCREENSHOT_PREFIX=community node test/community-desktop.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "package:mac": "node scripts/package.mjs",
    "check": "npm run verify:public && npm test",
    "postinstall": "node scripts/install-hooks.mjs",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.65.0",
    "electron": "42.11.16",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@composio/core": "0.28.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex-sdk": "0.167.0",
    "dompurify": "3.4.17",
    "linkedom": "0.18.15",
    "marked": "18.1.3",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptadvisers/gratis-community.git"
  },
  "homepage": "https://github.com/promptadvisers/gratis-community",
  "bugs": {
    "url": "https://github.com/promptadvisers/gratis-community/issues"
  },
  "author": "PromptAdvisers",
  "desktopName": "com.gratis.desktop"
}
